{
	"schemaVersion": 1,
	"id": "director",
	"version": "${version}",
	"name": "Director",
	"description": "This is an example description! Tell everyone what your mod is about!",
	"authors": [
		"Me!"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/FabricMC/fabric-example-mod"
	},
	"license": "CC0-1.0",
	"icon": "assets/director/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"teddy.director.Director"
		],
		"client": [
			"teddy.director.client.DirectorClient"
		]
	},
	"mixins": [
		"director.mixins.json",
		{
			"config": "director.client.mixins.json",
			"environment": "client"
		}
	],
	"accessWidener": "director.accesswidener",
	"depends": {
		"fabricloader": ">=0.20.1",
		"minecraft": "~26.2",
		"java": ">=25",
		"fabric-api": "*"
	}
}